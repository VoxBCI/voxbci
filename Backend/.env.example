/**
 * VoxBCI API — local environment.
 *
 * Copy to `.env` and fill in. Node loads it with `process.loadEnvFile()`
 * (see `src/config/env.ts`), so no dotenv dependency is needed.
 */

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
# 4000 is used by this API; 8081 is the Expo dev server.
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Dev login lets you exercise every endpoint before Google OAuth exists.
# Set to `false` in production — the route then 404s.
AUTH_DEV_MODE=true

# HS256 signing key. Must be >= 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-48-byte-base64url-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Client + storage
# ---------------------------------------------------------------------------
# Comma-separated allow-list. 8081 is Expo web, 19006 is legacy Expo web.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# JSON "database" directory. Gitignored; delete it to start from scratch.
DATA_DIR=data
