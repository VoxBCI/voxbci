# Copy to `.env` and fill in. Expo loads `.env` from this directory.
#
# CARTO basemap key used by the discovery map (light: Voyager, dark: dark_all).
# Get one at https://carto.com/basemaps — the tile URL looks like
# https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=...
# Expo inlines EXPO_PUBLIC_* values into the client bundle, so treat it as a
# public key. Leaving this empty falls back to unkeyed CARTO tiles.
EXPO_PUBLIC_MAP_API_KEY=

# ---------------------------------------------------------------------------
# Local API
# ---------------------------------------------------------------------------
# Where `Backend/` is running. Defaults to http://localhost:4000, which works
# for web and simulators. A physical device needs the dev machine's LAN address
# (e.g. http://192.168.1.20:4000) — the app derives it from the Expo dev server
# automatically, so only set this to override.
EXPO_PUBLIC_API_URL=

# Account used by the auth screen's "Continue with Google" button while the
# backend is in AUTH_DEV_MODE (no Google credentials needed).
EXPO_PUBLIC_DEV_EMAIL=demo@voxbci.app
